{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OpenNoxBot",
  "version": "0.0.1",
  "identifier": "dev.noxidsoft.opennoxbot",
  "build": {
    "beforeDevCommand": "trunk serve",
    "beforeBuildCommand": "trunk build --release",
    "devUrl": "http://127.0.0.1:1420",
    "frontendDist": "../omb-ui/dist"
  },
  "app": {
    "windows": [{ "title": "OpenNoxBot", "width": 1100, "height": 760 }],
    "security": { "csp": null }
  },
  "bundle": { "active": true, "targets": "all", "icon": ["icons/icon.png"] }
}
