{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OpenNoxBot",
  "version": "0.0.1",
  "identifier": "dev.noxidsoft.opennoxbot",
  "build": {
    "beforeDevCommand": { "script": "trunk serve", "cwd": "../omb-ui" },
    "beforeBuildCommand": { "script": "trunk build --release", "cwd": "../omb-ui" },
    "devUrl": "http://127.0.0.1:1420",
    "frontendDist": "../omb-ui/dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [{ "title": "OpenNoxBot", "width": 1100, "height": 760 }],
    "security": { "csp": null }
  },
  "bundle": { "active": true, "targets": "all", "icon": ["icons/icon.png"] }
}
